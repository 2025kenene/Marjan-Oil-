tem.numBL+' du '+item.date+'</div><div style="font-size:14px;font-weight:bold;font-style:italic;margin-top:3px;">'+(isPir?'*REGIME SOUS DOUANE':'*REGIME DOUANIER : TTC')+'</div></div><table class="dp-tbl"><thead><tr><th>REF</th><th>DESIGNATION</th><th>UNITE</th><th>QTE</th></tr></thead><tbody>';lines.forEach(function(l){content+='<tr><td>'+(l.reference||'')+'</td><td class="left">'+(l.prodName||'')+'</td><td>LITRE</td><td>'+(l.qty||'')+'</td></tr>';});content+='</tbody></table><div style="font-weight:bold;font-size:13px;text-transform:uppercase;margin:12px 0 5px;text-align:center;">Compartimentage</div><table class="dp-tbl"><thead><tr><th style="width:25%;">Produit</th>';for(var i=1;i<=nbC;i++)content+='<th>N'+i+'</th>';content+='</tr></thead><tbody>';['Gasoil','Super','Diesel','Melange'].forEach(function(p){content+='<tr><td class="left" style="font-weight:bold;">'+p+'</td>';for(var j=1;j<=nbC;j++)content+='<td>'+((comp[p]&&comp[p]['c'+j])||'')+'</td>';content+='</tr>';});content+='</tbody></table><div class="dp-transport"><div class="dp-transport-item"><strong>TRANSPORTEUR :</strong> '+(item.transporteur||'')+'</div><div class="dp-transport-item"><strong>VEHICULE :</strong> '+(item.vehicule||'')+'</div><div class="dp-transport-item"><strong>CHAUFFEUR :</strong> '+(item.chauffeur||'')+'</div></div><div class="dp-sigs"><div class="dp-sig"><div class="dp-sig-label">MARJAN OIL</div>'+getStampSigHTML(type)+'<div class="dp-sig-line">Signature et Cachet</div></div><div class="dp-sig"><div class="dp-sig-label">LE CHAUFFEUR</div><div style="min-height:80px;"></div><div class="dp-sig-line">Signature</div></div><div class="dp-sig"><div class="dp-sig-label">LE CLIENT</div><div style="min-height:80px;"></div><div class="dp-sig-line">Signature et Cachet</div></div></div>';}else if(type==='factures'){var tHT=parseFloat(item.totalHT)||0,tQty=parseFloat(item.totalQty)||0;if(tHT===0&&lines.length>0){tHT=lines.reduce(function(s,l){return s+(parseFloat(l.price)||0)*(parseFloat(l.qty)