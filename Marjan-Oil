function printDoc(type,id){var item=(db[type]||[]).find(function(x){return String(x.id)===String(id);});if(!item)return alert('Introuvable');fixItem(item);if(localCache[type]&&localCache[type][String(id)]){var ca=localCache[type][String(id)];if(ca.lines&&ca.lines.length>0)item.lines=ca.lines;if(ca.compartimentage)item.compartimentage=ca.compartimentage;if(ca.totalHT!==undefined)item.totalHT=ca.totalHT;if(ca.tva!==undefined)item.tva=ca.tva;if(ca.totalTTC!==undefined)item.totalTTC=ca.totalTTC;if(ca.totalQty!==undefined)item.totalQty=ca.totalQty;}if(item.lines&&item.lines.length>0&&type==='factures'){var th=item.lines.reduce(function(s,l){return s+((parseFloat(l.price)||0)*(parseFloat(l.qty)||0));},0),tq=item.lines.reduce(function(s,l){return s+(parseFloat(l.qty)||0);},0);if(!item.totalHT)item.totalHT=th;if(!item.totalQty)item.totalQty=tq;var bt=parseFloat(item.baseTaxable)||th;item.totalTTC=roundToNice(bt+Math.round(bt*0.18)+(isDieselInvolved(item.clientId,item.lines)?0:14.5*tq));item.montantLettres=item.montantLettres||nombreEnLettres(item.totalTTC);}var html=generateDocHTML(type,item);document.getElementById('preview-page').innerHTML=html;document.getElementById('document-template').innerHTML=html;document.getElementById('preview-overlay').classList.add('open');}
